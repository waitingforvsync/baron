\\ Define constants

ncam    = 256                   \\ Number of camera positions around the loop (one table entry each)
radius  = 375                   \\ World radius of the camera path
camorig = {600, 32, 600}        \\ Centre of the Lissajous figure (y = camera height)
objecty = 0                     \\ All objects sit on the ground plane
focal   = 128                   \\ Perspective scale
near    = 64                    \\ Near plane distance
lookahead = 1000                \\ camera aims at the ground this far ahead of it

\\ Define object array: {x, y, z, size, colour}

objects = {
    { 365, objecty,   45, 64, 2},
    { 820, objecty,   55, 64, 1},
    { 235, objecty,   65, 64, 1},
    { 995, objecty,  110, 64, 2},
    { 700, objecty,  140, 64, 1},
    { 580, objecty,  195, 64, 1},
    { 145, objecty,  260, 64, 3},
    { 390, objecty,  260, 64, 2},
    {1140, objecty,  315, 64, 3},
    { 585, objecty,  335, 64, 1},
    { 940, objecty,  335, 64, 1},
    { 750, objecty,  365, 64, 3},
    { 465, objecty,  380, 64, 2},
    {  70, objecty,  445, 64, 3},
    {1075, objecty,  460, 64, 1},
    { 340, objecty,  570, 64, 3},
    { 485, objecty,  585, 64, 1},
    { 755, objecty,  640, 64, 2},
    {1105, objecty,  700, 64, 1},
    { 265, objecty,  775, 64, 2},
    {  40, objecty,  780, 64, 1},
    { 940, objecty,  810, 64, 2},
    { 760, objecty,  820, 64, 1},
    { 565, objecty,  890, 64, 2},
    { 145, objecty,  935, 64, 3},
    { 345, objecty,  940, 64, 3},
    { 930, objecty,  960, 64, 1},
    { 790, objecty, 1035, 64, 1},
    {1135, objecty, 1040, 64, 2},
    { 445, objecty, 1085, 64, 2},
    { 940, objecty, 1135, 64, 1},
    { 180, objecty, 1160, 64, 1},
}

nobj = LEN(objects)             \\ Number of objects

\\ Define user-defined functions

\\ Normalize: list of {x,y,z} -> list of {x,y,z}
FUNCTION normalise(v) = v / ZIP(SQRT(SUM(v*v, 1)))

\\ Cross-product: {x,y,z} X {x,y,z} -> {x,y,z}
FUNCTION cross(a, b)
    x = a[..,1]*b[..,2] - a[..,2]*b[..,1]
    y = a[..,2]*b[..,0] - a[..,0]*b[..,2]
    z = a[..,0]*b[..,1] - a[..,1]*b[..,0]
= ZIP(x, y, z)

\\ Dot product: (list of {x,y,z}).(list of {x,y,z}) -> list of scalars
FUNCTION viewdot(rel, basis) = SUM(rel * ZIP(basis), 2)

FUNCTION clamp(v, lo, hi) = MIN({MAX({v, lo}, 0), hi}, 0)

; Round-to-nearest stopgap: baron's ROUND( currently truncates toward zero, so
; shift by half away from zero first. Delete once baron's ROUND does this itself.
FUNCTION nearest(v)
    s = (v >= 0)*2 - 1
= ROUND(v + s*0.5)

\\ Define camera path
\\ This is a 2:1 Lissajous curve with ncam (128) positions
\\ campath is a list of 128 {x, y, z} vectors

k = 2*PI / ncam
t = 0 ..< ncam
;campath = camorig + ZIP(SIN(2*t*k), FULL(ncam, 0), SIN(1*t*k)) * radius
campath = camorig + ZIP(COS(t*k)/(1+SIN(t*k)^2), FULL(ncam, 0), SIN(2*t*k)/(2*(1+SIN(t*k)^2))) * radius

\\ Define camera basis for each camera position
\\ We calculate the heading direction from the derivative of the Lissajous curve
\\ The forward direction is the heading direction pitched down to look at the horizon
\\ The rest of the basis is calculated assuming no roll.

;hdg   = normalise(ZIP(2*COS(2*t*k), FULL(ncam, 0), 1*COS(1*t*k)))   \ unit heading, ground plane
hdg   = normalise(ZIP(SIN(t*k)*(SIN(t*k)^2-3)/(1+SIN(t*k)^2)^2, FULL(ncam, 0), (1-3*SIN(t*k)^2)/(1+SIN(t*k)^2)^2))
fwd   = normalise(hdg*lookahead + {0, -camorig[1], 0})              \ at the ground, lookahead units on
right = ZIP(hdg[.., 2], FULL(ncam, 0), -hdg[.., 0])                 \ horizontal, perp to the heading
up    = cross(fwd, right)                                           \ tilted back to match fwd

\\ Get camera relative positions, all object positions at once

objpos = objects[.., 0..2]                    \ Extract just object {x,y,z}
rel    = objpos - ZIP(campath)                \ ncam x 1 x 3 against Nx3 -> ncam x N x 3

\\ Get view space via dot products (each ncam x N)

vx = viewdot(rel, right)
vy = viewdot(rel, up)
vz = viewdot(rel, fwd)

\\ Project to the MODE 5 screen

; Projection happens in square-pixel space (256 wide, focal 128 = 90 degree FOV), then x
; halves onto the 128 double-width columns. Object positions are the bottom-centre of the
; square: syc is the sprite's bottom row and it extends h rows upward from there.
; Horizontal extent goes out as clamped left/right(exclusive) columns, so a partially
; onscreen object still draws - the clamping IS the x clip, done here instead of at
; render time (sprite width = h/2 columns, half-width h/4).

vzc = MAX({vz, near}, 0)                      \ safe divisor (culled entries masked below)
px  = focal*vx/vzc                            \ square-pixel projection
py  = focal*vy/vzc
h   = focal*objects[.., 3]/vzc                \ sprite height in pixel rows
sxc = px/2 + 64                               \ centre column (halved for double width)
syc = 64 - py                                 \ bottom row

; precision: every edge is rounded straight from its float position, clamping last,
; and the height comes from the DIFFERENCE of the rounded rows - never rounded on its
; own, or the bottom-row fraction and height fraction beat against each other and the
; top edge wobbles as the camera moves (7x the edge jitter, measured)
xlc = clamp(nearest(sxc - h/4), 0, 128)       \ left column, clamped to the screen
xrc = clamp(nearest(sxc + h/4), 0, 128)       \ right column, exclusive

; vertical clip: with the near plane this close a sprite can poke off the top or
; bottom of the screen, and the renderer has no y clip - so clamp the bottom row
; and the top row to 0..127 here

ybi = nearest(syc)                            \ bottom row, from the float bottom edge
yti = nearest(syc - h) + 1                    \ top row, from the float top edge
ybc = MIN({ybi, 127}, 0)                      \ clipped bottom row
tpc = MAX({yti, 0}, 0)                        \ clipped top row
hgt = ybc - tpc + 1                           \ height from the rounded rows (<= 0 = fully off)

; visible = beyond the near plane AND >= one column AND >= one row after clipping -
; the renderer sees xr > xl and in-screen extents whenever the height byte is nonzero

vis = (vz > near) * (xrc > xlc) * (hgt >= 1)

xlb = xlc*vis                                 \ masked: culled entries emit clean zeros
xrb = xrc*vis
syb = ybc*vis
szb = hgt*vis                                 \ height 0 = the renderer's stop marker

\\ Depth-sort the objects per camera position, furthest first

; The tables become slot tables: slot 0 holds whatever object is furthest at that camera
; index, so the renderer just walks slots 0..N-1 painting far to near. Object identity now
; varies per slot, so colour rides along as a table too.

; One flat sort does all ncam per-camera sorts at once: flatten everything to ncam*N
; records and sort by a composite key with the camera index in the high part and the depth
; in the low part. Ascending key = camera-major groups, each furthest-first (the -vz).
; Stability doesn't matter - the key totally orders everything we care about. The window
; just has to be wider than any depth range, and the data itself tells us that.

w    = 2*MAX(ABS(vz)) + 1                     \ group window, no overlap possible
vzs  = vz*vis                                 \ culled entries sort as depth 0 - behind the near plane
                                              \ so they land after every visible one and the renderer stops at size=0
key  = ZIP(t)*w - vzs
colb = FULL(ncam, objects[.., 4])             \ colour broadcast to ncam x N

recs    = ZIP(FLATTEN(key), FLATTEN(vz), FLATTEN(xlb), FLATTEN(xrb), FLATTEN(syb), FLATTEN(szb), FLATTEN(colb))
sortedf = SORT(recs, 0)                       \ (ncam*N) x 7, camera-major, far to near

; debug checks for now
PRINT "campath[32]    = ", campath[32]
PRINT "fwd[0]         = ", fwd[0]
PRINT "up[0]          = ", up[0]
PRINT "shape sortedf  = ", SHAPE(sortedf)
PRINT "vz    @ cam 102 = ", vz[102]
PRINT "slots @ cam 102 = ", sortedf[102*nobj ..< 103*nobj, 1]   ; visible ones descending
PRINT "h     @ cam 102 = ", sortedf[102*nobj ..< 103*nobj, 5]   ; then 0s to the end
PRINT "xl    @ cam 102 = ", sortedf[102*nobj ..< 103*nobj, 2]
PRINT "xr    @ cam 102 = ", sortedf[102*nobj ..< 103*nobj, 3]
PRINT "y     @ cam 102 = ", sortedf[102*nobj ..< 103*nobj, 4]
PRINT "slot0 colour   = ", sortedf[(0..7)*nobj, 6]

\\ Emit slot tables, ncam bytes each, indexed by camera position

; only as many slots as are ever simultaneously visible need emitting - beyond the
; busiest camera's count, every slot is zero for every camera position
maxvis = MAX(SUM(vis, 1))                     ; the busiest camera's visible count
nslots = maxvis                               ; ncam = 256 keeps tables page-aligned regardless
PRINT "max visible    = ", maxvis, " of ", nobj, " objects -> ", nslots, " slots emitted"
PRINT "path clearance = ", ROUND(SQRT(MIN(SUM(rel[.., .., {0,2}]^2, 2)))), " world units"

; slot j of camera i sits at flat index i*nobj + j, so each table is a strided gather.
; Emitted into the including file's section (camera.6502 places this after its code,
; page aligned).

; No FOR needed: the slot-major index grid is an outer product - a column of slot
; offsets (ZIP makes it nslots x 1) broadcast against the camera strides - and
; FLATTEN turns it into one big gather, emitting a whole table per EQUB.
slotidx = FLATTEN(ZIP(0 ..< nslots) + (0 ..< ncam)*nobj)
.tab_xl
    EQUB sortedf[slotidx, 2]
.tab_xr
    EQUB sortedf[slotidx, 3]
.tab_y
    EQUB sortedf[slotidx, 4]
.tab_h
    EQUB sortedf[slotidx, 5]
.tab_col
    EQUB sortedf[slotidx, 6]
