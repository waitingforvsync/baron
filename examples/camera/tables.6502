\\ **************************************************************************
\\ *
\\ *    Camera / object table generation
\\ *
\\ *    Everything here runs at ASSEMBLY time, in baron's expression
\\ *    language. Values are numbers or LISTS, and lists nest: a list of
\\ *    numbers is a vector, a list of {x,y,z} rows is a matrix, and so on.
\\ *    The shapes used here, in the comments below:
\\ *
\\ *        number            one value
\\ *        [ncam]            a list of ncam numbers (one per camera position)
\\ *        [ncam x 3]        ncam rows, each a {x, y, z} triple
\\ *        [ncam x N]        ncam rows, each with one number per object
\\ *        [ncam x N x 3]    ncam rows of N object rows of {x, y, z}
\\ *
\\ *    The one big idea is BROADCASTING: any arithmetic between two values
\\ *    works element-by-element, and if one side is "smaller" (a number
\\ *    against a list, or a 1-long axis against an N-long one) it is
\\ *    repeated to match. So [ncam x 1 x 3] - [N x 3] pairs EVERY camera
\\ *    with EVERY object in one expression, giving [ncam x N x 3].
\\ *
\\ **************************************************************************

\\ Define constants

ncam    = 256                   \\ Number of camera positions around the loop (one table entry each)
radius  = 375                   \\ World radius of the camera path
camorig = {600, 32, 600}        \\ Centre of the Lissajous figure (y = camera height)
objecty = 0                     \\ All objects sit on the ground plane
focal   = 128                   \\ Perspective scale
near    = 64                    \\ Near plane distance
lookahead = 1000                \\ camera aims at the ground this far ahead of it

\\ Define object array: {x, y, z, size, colour}

objects = {
    { 365, objecty,   45, 64, 2},
    { 820, objecty,   55, 64, 1},
    { 235, objecty,   65, 64, 1},
    { 995, objecty,  110, 64, 2},
    { 700, objecty,  140, 64, 1},
    { 580, objecty,  195, 64, 1},
    { 145, objecty,  260, 64, 3},
    { 390, objecty,  260, 64, 2},
    {1140, objecty,  315, 64, 3},
    { 585, objecty,  335, 64, 1},
    { 940, objecty,  335, 64, 1},
    { 750, objecty,  365, 64, 3},
    { 465, objecty,  380, 64, 2},
    {  70, objecty,  445, 64, 3},
    {1075, objecty,  460, 64, 1},
    { 340, objecty,  570, 64, 3},
    { 485, objecty,  585, 64, 1},
    { 755, objecty,  640, 64, 2},
    {1105, objecty,  700, 64, 1},
    { 265, objecty,  775, 64, 2},
    {  40, objecty,  780, 64, 1},
    { 940, objecty,  810, 64, 2},
    { 760, objecty,  820, 64, 1},
    { 565, objecty,  890, 64, 2},
    { 145, objecty,  935, 64, 3},
    { 345, objecty,  940, 64, 3},
    { 930, objecty,  960, 64, 1},
    { 790, objecty, 1035, 64, 1},
    {1135, objecty, 1040, 64, 2},
    { 445, objecty, 1085, 64, 2},
    { 940, objecty, 1135, 64, 1},
    { 180, objecty, 1160, 64, 1},
}

nobj = LEN(objects)             \\ Number of objects ("N" in the shape comments)

\\ Define user-defined functions

\\ Normalize: [rows x 3] -> [rows x 3], each row scaled to unit length.
\\ v*v squares every component; SUM(.., 1) adds along axis 1 (the x,y,z axis),
\\ giving one squared length per row; ZIP wraps each into a 1-long row so the
\\ divide broadcasts it across that row's three components.
FUNCTION normalise(v)
    lensq = SUM(v*v, 1)         \ [rows]      squared length of each row
    len   = ZIP(SQRT(lensq))    \ [rows x 1]  length, as a column
= v / len

\\ Cross-product: [rows x 3] X [rows x 3] -> [rows x 3], row by row.
\\ a[.., 1] slices one component from every row (".." = keep the row axis,
\\ 1 = take that element), so each line below is a whole column of numbers,
\\ and ZIP stitches the three result columns back into {x,y,z} rows.
FUNCTION cross(a, b)
    x = a[..,1]*b[..,2] - a[..,2]*b[..,1]
    y = a[..,2]*b[..,0] - a[..,0]*b[..,2]
    z = a[..,0]*b[..,1] - a[..,1]*b[..,0]
= ZIP(x, y, z)

\\ Dot product of every camera-relative position against that camera's basis
\\ vector: [ncam x N x 3] . [ncam x 3] -> [ncam x N].
\\ ZIP(basis) wraps each basis row as [ncam x 1 x 3], so the multiply pairs
\\ camera i's basis with camera i's N object rows (the 1 stretches to N);
\\ SUM(.., 2) then adds up each {x,y,z} product - the dot product itself.
FUNCTION viewdot(rel, basis) = SUM(rel * ZIP(basis), 2)

\\ Element-wise clamp of v into lo..hi, any shape.
\\ MAX({v, lo}, 0) folds the 2-list {v, lo} pairwise: element-wise max(v, lo).
\\ (Plain MAX(v, lo) would read lo as an axis number instead.)
FUNCTION clamp(v, lo, hi) = MIN({MAX({v, lo}, 0), hi}, 0)

\\ Define camera path
\\ A lemniscate of Bernoulli (figure-of-eight), ncam positions around the loop.
\\ Everything is derived from t, the list of camera indices - one entry per
\\ camera position, so every assignment below computes ALL positions at once.

k = 2*PI / ncam                 \\ number      angle step per camera position
t = 0 ..< ncam                  \\ [ncam]      camera indices 0, 1, .. ncam-1

sn  = SIN(t*k)                  \ [ncam]      sin of every camera's angle
cs  = COS(t*k)                  \ [ncam]      cos of every camera's angle
den = 1 + sn*sn                 \ [ncam]      the lemniscate's denominator

lemx = cs/den                   \ [ncam]      unit lemniscate, x
lemz = SIN(2*t*k)/(2*den)       \ [ncam]      unit lemniscate, z

;campath = camorig + ZIP(SIN(2*t*k), FULL(ncam, 0), SIN(1*t*k)) * radius
\\ ZIP stitches three [ncam] columns into [ncam x 3] rows; FULL(ncam, 0) is
\\ just a column of zeroes (the path stays at ground level - camorig lifts it).
\\ Adding camorig (a single {x,y,z}) broadcasts it onto every row.
campath = camorig + ZIP(lemx, FULL(ncam, 0), lemz) * radius   \ [ncam x 3]

\\ Define camera basis for each camera position
\\ We calculate the heading direction from the derivative of the curve
\\ The forward direction is the heading direction pitched down to look at the ground
\\ The rest of the basis is calculated assuming no roll.

dxdt = sn*(sn*sn - 3)/den^2     \ [ncam]      d/dt of the lemniscate, x
dzdt = (1 - 3*sn*sn)/den^2      \ [ncam]      d/dt of the lemniscate, z

;hdg   = normalise(ZIP(2*COS(2*t*k), FULL(ncam, 0), 1*COS(1*t*k)))   \ unit heading, ground plane
hdg = normalise(ZIP(dxdt, FULL(ncam, 0), dzdt))   \ [ncam x 3]  unit heading, ground plane

\\ Aim at the point on the ground `lookahead` units along the heading: the
\\ vector to it is (heading * lookahead) sideways and (-camera height) down.
\\ {0, -camorig[1], 0} is one triple, broadcast onto all ncam rows.
target = hdg*lookahead + {0, -camorig[1], 0}      \ [ncam x 3]  camera -> aimed point
fwd    = normalise(target)                        \ [ncam x 3]  unit forward, pitched down

\\ Right is the horizontal perpendicular of the heading: (z, 0, -x) per row.
right = ZIP(hdg[.., 2], FULL(ncam, 0), -hdg[.., 0])   \ [ncam x 3]
up    = cross(fwd, right)                             \ [ncam x 3]  tilted back to match fwd

\\ Get camera relative positions, all camera/object pairs at once

objpos = objects[.., 0..2]      \ [N x 3]     just the {x,y,z} of every object

\\ ZIP(campath) wraps each camera row in a 1-long list: [ncam x 1 x 3]. The
\\ subtract then broadcasts that 1 against the N object rows - every object
\\ position minus every camera position, in one expression.
rel = objpos - ZIP(campath)     \ [ncam x N x 3]  object positions, camera-relative

\\ Get view space coordinates: each object's position in each camera's frame

vx = viewdot(rel, right)        \ [ncam x N]  sideways offset (screen x direction)
vy = viewdot(rel, up)           \ [ncam x N]  vertical offset (screen y direction)
vz = viewdot(rel, fwd)          \ [ncam x N]  depth into the screen

\\ Project to the MODE 5 screen
\\ Projection happens in square-pixel space (256 wide, focal 128 = 90 degree
\\ FOV), then x halves onto the 128 double-width columns. Object positions are
\\ the bottom-centre of the square: syc is the sprite's bottom row and it
\\ extends h rows upward. From here every value is [ncam x N] - one number per
\\ camera/object pair - and stays a float until the final edge rounding.

vzc = MAX({vz, near}, 0)        \ [ncam x N]  divisor clamped at the near plane
                                \             (element-wise max again, so entries
                                \             behind the camera divide safely -
                                \             they are culled below anyway)
px  = focal*vx/vzc              \ [ncam x N]  the perspective divide
py  = focal*vy/vzc
h   = focal*objects[.., 3]/vzc  \ [ncam x N]  sprite height in pixel rows
                                \             (objects[.., 3] is the [N] sizes,
                                \             broadcast across the cameras)
sxc = px/2 + 64                 \ [ncam x N]  centre column (halved: double-width pixels)
syc = 64 - py                   \ [ncam x N]  bottom row (screen y grows downward)

; precision: every edge is rounded straight from its float position, clamping last,
; and the height comes from the DIFFERENCE of the rounded rows - never rounded on its
; own, or the bottom-row fraction and height fraction beat against each other and the
; top edge wobbles as the camera moves (7x the edge jitter, measured)

xlc = clamp(ROUND(sxc - h/4), 0, 128)   \ [ncam x N]  left column, on-screen
xrc = clamp(ROUND(sxc + h/4), 0, 128)   \ [ncam x N]  right column, exclusive
                                          \             (sprite width = h/2 columns,
                                          \             so half a width is h/4)

; vertical clip: with the near plane this close a sprite can poke off the top or
; bottom of the screen, and the renderer has no y clip - so clamp the bottom row
; and the top row to 0..127 here

ybi = ROUND(syc)              \ [ncam x N]  bottom row, from the float bottom edge
yti = ROUND(syc - h) + 1      \ [ncam x N]  top row, from the float top edge
ybc = MIN({ybi, 127}, 0)        \ [ncam x N]  bottom row clipped to the screen
tpc = MAX({yti, 0}, 0)          \ [ncam x N]  top row clipped to the screen
hgt = ybc - tpc + 1             \ [ncam x N]  height from the rounded rows
                                \             (<= 0 means fully off screen)

\\ Visibility: 1 where the sprite should be drawn, 0 where not.
\\ Each comparison broadcasts element-wise and yields 1 or 0, and multiplying
\\ the three masks together is a logical AND. A visible entry is guaranteed to
\\ give the renderer xr > xl and rows inside 0..127, so it never clips.

vis = (vz > near) * (xrc > xlc) * (hgt >= 1)   \ [ncam x N]  1 = draw it

\\ The emitted values: multiplying by vis zeroes every culled entry, so they
\\ emit as clean zero bytes (and a zero height is the renderer's stop marker).

xlb = xlc*vis                   \ [ncam x N]  left column, or 0
xrb = xrc*vis                   \ [ncam x N]  right column, or 0
syb = ybc*vis                   \ [ncam x N]  bottom row, or 0
szb = hgt*vis                   \ [ncam x N]  height, or 0 = stop marker

\\ Depth-sort the objects per camera position, furthest first

; The tables become slot tables: slot 0 holds whatever object is furthest at that camera
; index, so the renderer just walks slots 0..N-1 painting far to near. Object identity now
; varies per slot, so colour rides along as a table too.

; One flat sort does all ncam per-camera sorts at once: flatten everything to ncam*N
; records and sort by a composite key with the camera index in the high part and the depth
; in the low part. Ascending key = camera-major groups, each furthest-first (the -vz).
; Stability doesn't matter - the key totally orders everything we care about. The window
; just has to be wider than any depth range, and the data itself tells us that.

w   = 2*MAX(ABS(vz)) + 1        \ number      group window: MAX here folds the whole
                                \             [ncam x N] table down to one value
vzs = vz*vis                    \ [ncam x N]  culled entries sort as depth 0 - behind
                                \             the near plane - so they land after every
                                \             visible one and the renderer stops at size=0

camcol = ZIP(t)                 \ [ncam x 1]  camera index as a column, so the multiply
                                \             broadcasts it across each row's N objects
key    = camcol*w - vzs         \ [ncam x N]  sort key: camera-major, furthest-first

colb = FULL(ncam, objects[.., 4])   \ [ncam x N]  the [N] colours, copied ncam times

\\ Flatten each [ncam x N] table into one long [ncam*N] list (row-major, so
\\ camera-major order), then ZIP the seven lists into one record per entry.

allkey = FLATTEN(key)           \ [ncam*N]
allvz  = FLATTEN(vz)            \ [ncam*N]  (kept in the record for debugging)
allxl  = FLATTEN(xlb)           \ [ncam*N]
allxr  = FLATTEN(xrb)           \ [ncam*N]
ally   = FLATTEN(syb)           \ [ncam*N]
allh   = FLATTEN(szb)           \ [ncam*N]
allcol = FLATTEN(colb)          \ [ncam*N]

recs = ZIP(allkey, allvz, allxl, allxr, ally, allh, allcol)   \ [ncam*N x 7] records

\\ SORT orders the records ascending by field 0 (the composite key), which
\\ groups them by camera and puts each camera's group furthest-first.

sortedf = SORT(recs, 0)         \ [ncam*N x 7]  camera-major, far to near

; debug checks for now
PRINT "campath[32]    = ", campath[32]
PRINT "fwd[0]         = ", fwd[0]
PRINT "up[0]          = ", up[0]
PRINT "shape sortedf  = ", SHAPE(sortedf)
PRINT "vz    @ cam 102 = ", vz[102]
PRINT "slots @ cam 102 = ", sortedf[102*nobj ..< 103*nobj, 1]   ; visible ones descending
PRINT "h     @ cam 102 = ", sortedf[102*nobj ..< 103*nobj, 5]   ; then 0s to the end
PRINT "xl    @ cam 102 = ", sortedf[102*nobj ..< 103*nobj, 2]
PRINT "xr    @ cam 102 = ", sortedf[102*nobj ..< 103*nobj, 3]
PRINT "y     @ cam 102 = ", sortedf[102*nobj ..< 103*nobj, 4]
PRINT "slot0 colour   = ", sortedf[(0..7)*nobj, 6]

\\ Emit slot tables, ncam bytes each, indexed by camera position

; only as many slots as are ever simultaneously visible need emitting - beyond the
; busiest camera's count, every slot is zero for every camera position

percam = SUM(vis, 1)            \ [ncam]      how many objects each camera can see
maxvis = MAX(percam)            \ number      the busiest camera's count
nslots = maxvis                 \ number      ncam = 256 keeps tables page-aligned regardless

PRINT "max visible    = ", maxvis, " of ", nobj, " objects -> ", nslots, " slots emitted"

relxz = rel[.., .., {0, 2}]     \ [ncam x N x 2]  horizontal components only ({0,2}
                                \                 gathers just the x and z elements)
PRINT "path clearance = ", ROUND(SQRT(MIN(SUM(relxz^2, 2)))), " world units"

; slot j of camera i sits at flat index i*nobj + j, so each table is a strided gather.
; Emitted into the including file's section (camera.6502 places this after its code,
; page aligned).

; No FOR needed: the flat indices of one whole table form a grid, built as an
; outer product - a column of slot numbers against the camera group offsets -
; and FLATTEN turns the grid into one long gather, a whole table per EQUB.

slotcol = ZIP(0 ..< nslots)     \ [nslots x 1]     slot numbers, as a column
camoff  = (0 ..< ncam)*nobj     \ [ncam]           where each camera's group starts
grid    = slotcol + camoff      \ [nslots x ncam]  flat record index of slot j, camera i
slotidx = FLATTEN(grid)         \ [nslots*ncam]    slot-major: table 0's bytes, then 1's..

.tab_xl
    EQUB sortedf[slotidx, 2]
.tab_xr
    EQUB sortedf[slotidx, 3]
.tab_y
    EQUB sortedf[slotidx, 4]
.tab_h
    EQUB sortedf[slotidx, 5]
.tab_col
    EQUB sortedf[slotidx, 6]
