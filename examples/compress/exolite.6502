\ **************************************************************************
\ *
\ *    The compressor: Exolite, a format inspired by Exomizer (but not
\ *    Exomizer's own), written as Baron FUNCTIONs
\ *
\ *    The same runs as lz.6502 - literals, matches, literals, ... until
\ *    LEN bytes are out - but every number is written with a table of
\ *    its own, fitted to the data, as Exomizer does:
\ *
\ *      LEN in 16 bits, then three tables of 16 widths, 4 bits each:
\ *        run counts (literal and match runs alike), lengths - 1, offsets
\ *      literal run   count, then each byte in 8 bits
\ *      match run     count, then for each match: length - 1, offset
\ *
\ *    A table splits the numbers from 1 up into 16 buckets, bucket i
\ *    holding 2^width[i] of them. A number is written as its bucket, i
\ *    ones and a zero, then its place in the bucket in width[i] bits.
\ *
\ **************************************************************************

FUNCTION bits(v, n) = 2^n + v                           ; v in n bits
FUNCTION cost(f)    = BITLEN(f) - 1                     ; a field's width; -1 if impossible

never  = 2^40                                           ; dearer than any real total
gammas = {0..15, 0..15, 0..15}                          ; widths 0, 1, 2, ...: Elias gamma codes

\ Every number's code from 0 to limit, under one table (0 has none). Bucket
\ i's codes are its number - i ones and a zero - followed by w more bits.

FUNCTION bucket_codes(widths, i, left)
    IF i == LEN(widths) OR left <= 0
        r = {}
    ELSE
        w = widths[i]
        k = MIN({2^w, left})
        r = CONCAT(bits(2^(i + 1) - 2, i + 1) * 2^w + (0..<k), bucket_codes(widths, i + 1, left - k))
    ENDIF
= r

FUNCTION code_table(widths, limit) = CONCAT({0}, bucket_codes(widths, 0, limit))

\ The three tables of codes for data n bytes long. Matches stop at 256 bytes,
\ so the decompressor can copy one with an 8-bit index.

FUNCTION tables(widths, n) = {code_table(widths[0], n), code_table(widths[1], 255), code_table(widths[2], n)}

FUNCTION parse_with(t, data)
    runs = cost(t[0])
    lits = cost(bits(0..255, 8))
    lens = CONCAT({-1}, cost(t[1]))                     ; length l is written as l - 1
= LZ_PARSE(data, runs, lits, runs, lens, cost(t[2]))


\ ---- fitting a table ----

\ How many of the numbers are below s, for each s from 0 to e. Every s is
\ added once so FIND always finds it: the first s in the sorted list has
\ 0..s-1 in front of it, and the numbers below s.

FUNCTION below_counts(values, e) = FIND(SORT(CONCAT(values, 0..e)), 0..e) - (0..e)

FUNCTION smaller(a, b) = b + (a < b) * (a - b)          ; element by element

\ The search runs from the last bucket back to the first: a layer holds, for
\ every s from 0 to e, the fewest bits for the numbers from s up using buckets
\ i onwards. Bucket i, w wide, costs i + 1 + w bits for each number in it and
\ moves on to s + 2^w. Past the largest number (s = e) nothing is left to pay
\ for. The lists are padded so reaching past e reads as reaching e, and every
\ shift is a slice.

FUNCTION in_reach(b, e, w)                              ; how many numbers are in s..s + 2^w - 1, by width
    c = b[2^w..e + 2^w] - b[0..e]
    IF w == 0
        r = {c}
    ELSE
        r = CONCAT(in_reach(b, e, w - 1), {c})
    ENDIF
= r

FUNCTION best_of(c, w, counts, g, e)                    ; the cheapest width from 0 to w
    t = counts[w] * (c + w) + g[2^w..e + 2^w]
    IF w == 0
        r = t
    ELSE
        r = smaller(t, best_of(c, w - 1, counts, g, e))
    ENDIF
= r

FUNCTION layers(i, counts, e, wmax)                     ; the layers for buckets i to 16
    IF i == 16
        r = {CONCAT(REPEATED(e, never), {0})}
    ELSE
        rest = layers(i + 1, counts, e, wmax)
        g    = CONCAT(rest[0], REPEATED(2^wmax, 0))
        r    = CONCAT({best_of(i + 1, wmax, counts, g, e)}, rest)
    ENDIF
= r

\ Back from the front: at each bucket, the narrowest width that does best.
\ Buckets past the largest number get width 15, to reach as far as they can.

FUNCTION trace(ls, below, e, wmax, i, s)
    IF i == 16
        r = {}
    ELIF s == e
        r = REPEATED(16 - i, 15)
    ELSE
        ws    = 0..wmax
        to    = smaller(s + 2^ws, e)
        cands = (below[to] - below[s]) * (i + 1 + ws) + ls[i + 1][to]
        w     = FIND(cands, MIN(cands))
        r     = CONCAT({w}, trace(ls, below, e, wmax, i + 1, smaller(s + 2^w, e)))
    ENDIF
= r

\ The 16 widths that write these numbers in the fewest bits. A width wider
\ than wmax reaches no further and costs more. Nothing stops a later bucket
\ costing less than an earlier one, though LZ_PARSE assumes offsets never get
\ cheaper: the parse it finds is still sound then, just perhaps not the
\ cheapest.

FUNCTION fit(values)
    vs     = FLATTEN(values)
    e      = MAX(CONCAT({1}, vs)) + 1
    below  = below_counts(vs, e)
    wmax   = MIN({15, BITLEN(e)})
    counts = in_reach(CONCAT(below, REPEATED(2^wmax, below[e])), e, wmax)
= trace(layers(0, counts, e, wmax), below, e, wmax, 0, 1)


\ ---- what a parse wrote ----

\ The numbers in each table, as {run counts, lengths - 1, offsets}, gathered
\ by halving the list of runs. ZIP pairs the halves up table by table; fit
\ flattens them.

FUNCTION run_values(run)
    IF run[0] == 0
        r = {LEN(run[1]), {}, {}}
    ELSE
        r = {LEN(run[1][0]), run[1][1] - 1, run[1][0]}
    ENDIF
= r

FUNCTION run_list_values(runs)
    n = LEN(runs)
    IF n == 0
        r = {{}, {}, {}}
    ELIF n == 1
        r = run_values(runs[0])
    ELSE
        h = n DIV 2
        r = ZIP(run_list_values(runs[0..<h]), run_list_values(runs[h..<n]))
    ENDIF
= r

FUNCTION fit_all(runs)
    v = run_list_values(runs)
= {fit(v[0]), fit(v[1]), fit(v[2])}

\ Fit tables to what a parse wrote, parse again with them, and keep going
\ while that saves anything. p is the parse made with widths; the result is
\ the best {widths, parse} found.

FUNCTION settle(widths, p, data, tries)
    next = fit_all(p[1])
    q    = parse_with(tables(next, LEN(data)), data)
    IF q[0] >= p[0]
        r = {widths, p}
    ELIF tries == 1
        r = {next, q}
    ELSE
        r = settle(next, q, data, tries - 1)
    ENDIF
= r


\ ---- the stream ----

FUNCTION run_codes(run, t)
    IF run[0] == 0
        r = {t[0][LEN(run[1])], bits(run[1], 8)}
    ELSE
        offs = run[1][0]
        lens = run[1][1]
        r = {t[0][LEN(offs)], ZIP(t[1][lens - 1], t[2][offs])}
    ENDIF
= r

FUNCTION encode(runs, t)
    n = LEN(runs)
    IF n == 0
        r = {}
    ELIF n == 1
        r = run_codes(runs[0], t)
    ELSE
        h = n DIV 2
        r = {encode(runs[0..<h], t), encode(runs[h..<n], t)}
    ENDIF
= r

\ The transform: start from gamma codes, settle the tables, then write them
\ and the runs.

FUNCTION exolite(data)
    n    = LEN(data)
    best = settle(gammas, parse_with(tables(gammas, n), data), data, 8)
    t    = tables(best[0], n)
= BITPACK({bits(n, 16), bits(FLATTEN(best[0]), 4), encode(best[1][1], t)})
