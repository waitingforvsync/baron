\ **************************************************************************
\ *
\ *    Compressed title screen: Exomizer-style
\ *
\ *    The same screen as compress_lz.6502, compressed by exo.6502 instead:
\ *    every count, length and offset is written with a table fitted to
\ *    the screen. The decompressor rebuilds the tables from the stream's
\ *    header, then unpacks straight into screen memory.
\ *
\ *    Build:  baron boot.6502 compress_lz.6502 compress_exo.6502 --opt 3 -o compress.ssd
\ *    Run:    *RUN EXO
\ *
\ **************************************************************************

INCLUDE "exo.6502"

oswrch = &FFEE
screen = &5800
tables = screen - 3 * 49                ; the rebuilt tables, just below the screen

SECTION Loader, org = &1900, load = &FFFF1900, exec = &FFFF0000+entry, filename = "EXO", guard = tables

ZA_POOL &70..&8F
ZA_AUTO2 dest, copy, limit, count
ZA_AUTO1 bitbuf, temp, length

.entry
    ZA_ENTRY
    LDX #0                      ; MODE 5, cursor off
.@  LDA vdu,X
    JSR oswrch
    INX
    CPX #vdu_end - vdu
    BNE @-

    LDA #LO(packed)
    STA src
    LDA #HI(packed)
    STA src+1
    LDA #LO(screen)
    STA dest
    LDA #HI(screen)
    STA dest+1
    JSR unpack
.hang
    JMP hang

.vdu
    EQUB 22, 5
    EQUB 23, 1, 0, 0, 0, 0, 0, 0, 0, 0
.vdu_end


\ Unpack the stream at src to dest.

.unpack
    LDA #&80                    ; an empty bit buffer: just the sentinel
    STA bitbuf
    LDY #16                     ; LEN, so where the output stops
    JSR getbits
    CLC
    ADC dest
    STA limit
    LDA temp
    ADC dest+1
    STA limit+1

    LDX #0                      ; the three tables of 16 buckets: each one's width, and its first number
.bucket
    LDA #0
    LDY #4
    JSR getbits
    STA width,X
    TAY
    TXA
    AND #15
    BNE @+
    LDA #1                      ; a table's first bucket starts at 1
    STA base_lo,X
    LSR A
    STA base_hi,X
.@  LDA #0                      ; the next bucket starts 2^width further on
    STA temp
    SEC
.@  ROL A
    ROL temp
    DEY
    BPL @-
    ADC base_lo,X               ; C is clear: the 1 never reaches temp's top bit
    STA base_lo+1,X
    LDA temp
    ADC base_hi,X
    STA base_hi+1,X
    INX
    CPX #48
    BNE bucket

.literals                       ; a literal run: its count, then each byte in 8 bits
    JSR run_count
.literal
    LDY #8
    JSR getbits
    INY                         ; getbits leaves Y at -1
    STA (dest),Y
    INC dest
    BNE @+
    INC dest+1
.@  JSR counted
    BNE literal

.matches                        ; a match run: its count, then each match's length - 1 and offset
    JSR run_count
.match
    LDX #lengths - 1            ; at most 255: exo.6502 keeps matches to 256 bytes
    JSR getvalue
    STY length
    LDX #offsets - 1
    JSR getvalue
    STA temp                    ; copy = dest - offset
    TYA
    EOR #&FF
    SEC
    ADC dest
    STA copy
    LDA dest+1
    SBC temp
    STA copy+1
    LDY #&FF                    ; the copy may overlap what it writes: it reads it back
.@  INY
    LDA (copy),Y
    STA (dest),Y
    CPY length
    BNE @-
    TYA                         ; dest += Y + 1, C being set by CPY
    ADC dest
    STA dest
    BCC @+
    INC dest+1
.@  JSR counted
    BNE match
    BEQ literals

counts  = 0                     ; where each table's buckets start
lengths = 16
offsets = 32


\ The next run's count into count. Once the output is complete there is no next run: unpack is done,
\ so drop its return address and go straight back to whoever called it.

.run_count
    LDA dest
    CMP limit
    BNE @+
    LDA dest+1
    CMP limit+1
    BNE @+
    PLA
    PLA
    RTS
.@  LDX #counts - 1
    JSR getvalue
    STY count
    STA count+1
    RTS

\ Count down one; Z set when count reaches 0.

.counted
    LDA count
    BNE @+
    DEC count+1
.@  DEC count
    LDA count
    ORA count+1
    RTS

\ A number from the table whose first bucket is X + 1, low byte in Y and high in A: its bucket, as
\ ones up to a 0, then that bucket's width in bits, added to the bucket's first number. C is clear for
\ the add either way: the 0 left it so, and so does any bit getbits shifts out of temp.

.getvalue
.@  INX
    JSR getbit
    BCS @-
    LDA #0
    STA temp
    LDY width,X
    JSR getbits
    ADC base_lo,X
    TAY
    LDA temp
    ADC base_hi,X
    RTS

\ Y more bits, shifted in under A (low) and temp (high). Leaves Y at -1.

.@  JSR getbit
    ROL A
    ROL temp
.getbits
    DEY
    BPL @-
    RTS

\ The next bit into C, keeping A, X and Y. bitbuf holds the bits still to come with a sentinel 1 below
\ them. Shifting out the sentinel empties the byte and leaves C set, so ROL brings it straight back in
\ under the next byte's bits.

.getbit
    ASL bitbuf
    BNE @+
    PHA
src = P% + 1                    ; the next byte's address: this operand, moved on as we go
    LDA &FFFF
    INC src
    BNE got_byte
    INC src+1
.got_byte
    ROL A
    STA bitbuf
    PLA
.@  RTS


\ The screen, compressed by the exo FUNCTION as the section closes.

.packed
SECTION Screen, org = screen, transform = "exo"
    INCBIN "blurpscreen.bin"
ENDSECTION
.packed_end

SECTION Tables, org = tables, guard = screen, virtual = TRUE
.width      SKIP 48
.base_lo    SKIP 49             ; one spare: the last bucket's end is worked out too
.base_hi    SKIP 49
ENDSECTION

ENDSECTION

PRINT "Exo: screen packed from 8320 to ", packed_end - packed, " bytes; decompressor ", packed - unpack, " bytes"
